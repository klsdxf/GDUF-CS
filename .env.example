DB_PASSWORD=replace-with-a-random-url-safe-password
REDIS_PASSWORD=replace-with-a-random-url-safe-secret
LOGIN_SOURCE_SECRET=replace-with-a-different-random-secret
REDIS_NAMESPACE=gduf:production:v1
PUBLIC_ORIGIN=https://cs.example.edu.cn

# Optional. Set once to the first collection date in Asia/Shanghai (YYYY-MM-DD).
VISIT_STATS_START_DATE=

# Public frontend build mode: demo or api (rebuild web after changing)
VITE_PUBLIC_DATA_MODE=api
